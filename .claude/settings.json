{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-discard.py\"",
            "timeout": 10,
            "statusMessage": "git 명령을 확인한다"
          }
        ]
      }
    ]
  }
}
